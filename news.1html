<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ห้องข่าว สกร.สตึก</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Charmonman:wght@700&family=Kanit:wght@400;500;600;700&family=Sarabun:wght@400;600;700&display=swap">
<style>
/* Layout: preview canvas (4:5) beside a control column on desktop; stacked on phone with a sticky download bar */
:root{
  --bg:#EEF2F6; --surface:#FFFFFF; --ink:#16212D; --muted:#5A6878; --line:#D8DFE7;
  --accent:#0E4C8A; --accent-ink:#FFFFFF; --soft:#E3ECF6; --gold:#C99A1E;
  --f-head:"Kanit","Sarabun",Tahoma,sans-serif; --f-body:"Sarabun",Tahoma,sans-serif;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0F151C; --surface:#18212B; --ink:#E7EDF3; --muted:#9AA8B7; --line:#2A3644;
  --accent:#6FA8E6; --accent-ink:#0B1A2A; --soft:#1F2D3C; --gold:#E2B94A; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0F151C; --surface:#18212B; --ink:#E7EDF3; --muted:#9AA8B7; --line:#2A3644;
  --accent:#6FA8E6; --accent-ink:#0B1A2A; --soft:#1F2D3C; --gold:#E2B94A; color-scheme:dark}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:16px;line-height:1.5}
.top{padding-block:18px;padding-inline:16px;max-width:1240px;margin:0 auto;display:flex;align-items:center;gap:14px}
.mark{width:48px;height:48px;border-radius:50%;background:var(--accent);color:var(--accent-ink);display:grid;place-items:center;font:600 15px var(--f-head);flex:none}
h1{margin:0;font:600 22px/1.2 var(--f-head);text-wrap:balance}
.top p{margin:2px 0 0;color:var(--muted);font-size:14px}
.wrap{max-width:1240px;margin:0 auto;padding-inline:16px;padding-block:0 110px;display:grid;grid-template-columns:minmax(0,1fr) 440px;gap:24px;align-items:start}
.stage{position:sticky;top:calc(env(safe-area-inset-top,0px) + 12px);min-width:0}
.stage canvas{width:100%;max-width:640px;height:auto;display:block;margin:0 auto;border-radius:10px;box-shadow:0 10px 30px rgba(10,30,50,.18);background:#fff}
.hint{text-align:center;color:var(--muted);font-size:13px;margin:10px 0 0}
.panel{display:flex;flex-direction:column;gap:14px;min-width:0}
.blk{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px;display:flex;flex-direction:column;gap:12px;min-width:0}
.blk h2,.blk summary{margin:0;font:600 17px var(--f-head)}
.blk summary{cursor:pointer}
details.blk[open] summary{margin-bottom:4px}
.grp{font:500 13px var(--f-head);color:var(--muted);letter-spacing:.04em;margin:6px 0 -4px}
.tpls{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.tpl{display:flex;align-items:center;gap:8px;text-align:left;border:1px solid var(--line);background:var(--bg);color:var(--ink);border-radius:10px;padding:9px 10px;font:15px/1.3 var(--f-body);cursor:pointer;min-width:0}
.tpl .dot{width:16px;height:16px;border-radius:50%;flex:none;box-shadow:inset 0 0 0 3px rgba(255,255,255,.55)}
.tpl .no{font:600 12px var(--f-head);color:var(--muted);flex:none}
.tpl[aria-pressed="true"]{border-color:var(--accent);background:var(--soft);box-shadow:0 0 0 1px var(--accent)}
.sw{display:flex;flex-wrap:wrap;gap:8px}
.sw button{width:38px;height:38px;border-radius:50%;border:2px solid var(--line);cursor:pointer;position:relative}
.sw button[aria-pressed="true"]{border-color:var(--ink);box-shadow:0 0 0 3px var(--surface) inset}
.sw small{display:block;color:var(--muted);font-size:13px;width:100%}
label.f{display:flex;flex-direction:column;gap:4px;font:500 14px var(--f-head);color:var(--muted)}
input[type=text],textarea{font:16px/1.5 var(--f-body);color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:9px 11px;width:100%}
textarea{min-height:96px;resize:vertical}
input:focus-visible,textarea:focus-visible,button:focus-visible,.up:focus-within{outline:2px solid var(--accent);outline-offset:2px}
.up{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px dashed var(--accent);color:var(--accent);background:var(--soft);border-radius:10px;padding:10px 14px;font:500 15px var(--f-head);cursor:pointer}
.up input{position:absolute;width:1px;height:1px;opacity:0}
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.who{display:flex;gap:12px;align-items:center}
.who img,.who .empty{width:72px;height:72px;border-radius:50%;object-fit:cover;object-position:50% 25%;background:var(--bg);border:1px solid var(--line);flex:none}
.who .logo{border-radius:12px;object-fit:contain}
.plist{display:grid;grid-template-columns:repeat(auto-fill,minmax(92px,1fr));gap:8px}
.ph{position:relative;border-radius:10px;overflow:hidden;aspect-ratio:1;background:var(--bg);border:1px solid var(--line)}
.ph img{width:100%;height:100%;object-fit:cover;display:block}
.ph .ctl{position:absolute;inset:auto 0 0 0;display:flex;justify-content:space-between;background:rgba(0,0,0,.55)}
.ph .ctl button{background:none;border:0;color:#fff;font:600 15px var(--f-head);padding:4px 8px;cursor:pointer}
.ph .n{position:absolute;top:4px;left:4px;background:rgba(0,0,0,.6);color:#fff;font:600 12px var(--f-head);border-radius:6px;padding:0 6px}
.note{font-size:13px;color:var(--muted);margin:0}
.ghost{background:none;border:1px solid var(--line);color:var(--muted);border-radius:10px;padding:8px 12px;font:14px var(--f-body);cursor:pointer;align-self:flex-start}
.bar{position:fixed;left:0;right:0;bottom:0;padding:10px 16px calc(10px + env(safe-area-inset-bottom,0px));background:color-mix(in srgb,var(--surface) 92%,transparent);backdrop-filter:blur(8px);border-top:1px solid var(--line);display:flex;gap:10px;justify-content:center;z-index:5}
.bar button{font:600 16px var(--f-head);border-radius:12px;padding:12px 18px;cursor:pointer;border:1px solid var(--line);background:var(--surface);color:var(--ink)}
.bar #dl{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);flex:0 1 320px}
.ov{position:fixed;inset:0;background:rgba(5,10,15,.88);z-index:10;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:16px}
.ov img{max-width:100%;max-height:78vh;border-radius:8px}
.ov p{color:#fff;margin:0;text-align:center}
.ov button{font:600 16px var(--f-head);border-radius:12px;padding:10px 22px;border:0;cursor:pointer}
.toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:10px;z-index:11;font-size:15px;max-width:calc(100% - 32px);text-align:center}
@media (max-width:900px){
  .wrap{grid-template-columns:minmax(0,1fr)}
  .stage{position:static}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>

<header class="top">
  <div class="mark">สกร.</div>
  <div><h1>ห้องข่าว สกร.สตึก</h1><p>จดหมายข่าว A4 และภาพประชาสัมพันธ์ 1080×1350</p></div>
</header>

<main class="wrap">
  <section class="stage">
    <canvas id="cv" width="1080" height="1350" aria-label="ตัวอย่างภาพข่าว"></canvas>
    <p class="hint">ภาพตัวอย่างจะเปลี่ยนทันทีเมื่อแก้ข้อความหรือเพิ่มรูป</p>
  </section>

  <section class="panel">
    <div class="blk">
      <h2>เลือกเทมเพลต</h2>
      <div id="tpls"></div>
    </div>

    <div class="blk">
      <h2>โทนสี</h2>
      <div class="sw" id="sw"></div>
    </div>

    <div class="blk" id="b_photos">
      <h2>รูปภาพกิจกรรม</h2>
      <div class="row">
        <label class="up">+ เพิ่มรูปภาพ<input id="photo_file" type="file" accept="image/*" multiple></label>
        <span class="note" id="pcount"></span>
      </div>
      <div class="plist" id="plist"></div>
      <p class="note">เพิ่มได้สูงสุด 7 รูป รูปแรกเป็นรูปหลัก ใช้ปุ่ม ‹ › เพื่อสลับลำดับ</p>
    </div>

    <div class="blk" id="b_royal">
      <h2>พระบรมฉายาลักษณ์ / พระฉายาลักษณ์</h2>
      <div class="who"><img id="royal_prev" alt="" hidden><div class="empty" id="royal_empty"></div>
        <label class="up">เลือกรูป<input id="royal_file" type="file" accept="image/*"></label></div>
      <p class="note">ใช้รูปจากแหล่งทางราชการ เช่น สำนักพระราชวัง</p>
    </div>

    <div class="blk" id="b_dir">
      <h2>รูปและชื่อ ผอ.</h2>
      <div class="who"><img id="dir_prev" alt="" hidden><div class="empty" id="dir_empty"></div>
        <div class="row"><label class="up">เปลี่ยนรูป ผอ.<input id="dir_file" type="file" accept="image/*"></label><button class="ghost" id="dir_std" type="button">ใช้รูป ผอ. มาตรฐาน</button></div></div>
      <div class="row"><button class="up" id="dir_cut" type="button" hidden>ตัดพื้นหลังรูปนี้อัตโนมัติ</button><span class="note" id="cut_status"></span></div>
      <label class="f">ชื่อ ผอ.<input type="text" id="dir_name"></label>
      <label class="f">ตำแหน่ง<input type="text" id="dir_pos"></label>
      <p class="note">รูปมาตรฐานตัดพื้นหลังไว้แล้ว ถ้าเลือกรูปอื่นที่มีพื้นหลัง กด "ตัดพื้นหลังรูปนี้อัตโนมัติ" ได้ (ใช้ได้บน GitHub Pages) รูปครึ่งตัวพื้นหลังเรียบจะตัดได้ดีที่สุด</p>
    </div>

    <div class="blk">
      <h2>ข้อความ</h2>
      <div id="fields" style="display:flex;flex-direction:column;gap:12px"></div>
      <button class="ghost" id="reset" type="button">คืนค่าข้อความเริ่มต้นของเทมเพลตนี้</button>
    </div>

    <details class="blk">
      <summary>โลโก้และชื่อหน่วยงาน</summary>
      <div class="who"><img id="logo_prev" class="logo" alt="" hidden><div class="empty" id="logo_empty" style="border-radius:12px"></div>
        <label class="up">เลือกโลโก้<input id="logo_file" type="file" accept="image/*"></label></div>
      <label class="f">ชื่อเต็มหน่วยงาน (จดหมายข่าว)<input type="text" id="org_full"></label>
      <label class="f">ชื่อหน่วยงาน<input type="text" id="org_name"></label>
      <label class="f">บรรทัดรอง<input type="text" id="org_sub"></label>
      <p class="note">ใช้ไฟล์ PNG พื้นใสจะสวยที่สุด</p>
    </details>
  </section>
</main>

<div class="bar">
  <button id="dl" type="button">ดาวน์โหลดภาพ PNG</button>
  <button id="view" type="button">ดูภาพเต็ม</button>
</div>
<div class="ov" id="ov" hidden>
  <img id="ovimg" alt="ภาพข่าวสำหรับบันทึก">
  <p>กดค้างที่รูป แล้วเลือก "บันทึกรูปภาพ"</p>
  <button id="ovx" type="button">ปิด</button>
</div>
<div class="toast" id="toast" hidden></div>

<script>
(()=>{
let W=1080,H=1350;const KEY='skr-satuk-news.v2',OLDKEY='skr-satuk-news.v1';
const cv=document.getElementById('cv'),ctx=cv.getContext('2d');
const $=id=>document.getElementById(id);
const MONTHS=['มกราคม','กุมภาพันธ์','มีนาคม','เมษายน','พฤษภาคม','มิถุนายน','กรกฎาคม','สิงหาคม','กันยายน','ตุลาคม','พฤศจิกายน','ธันวาคม'];
const now=new Date(),Y=now.getFullYear()+543,TODAY=`${now.getDate()} ${MONTHS[now.getMonth()]} ${Y}`;
const ORG='สกร.ระดับอำเภอสตึก',FULLNAME='ศูนย์ส่งเสริมการเรียนรู้ระดับอำเภอสตึก';
const DEFAULT_DIR='director.png';
const DEFAULT_LOGO='logo.png';
const CONTACT='ติดต่อ ครูอ๋อ โทร 091-079-6382 · LINE sbrrnprasiththi';

const THEMES={
 blue:{n:'น้ำเงิน',primary:'#0E4C8A',dark:'#0A355F',accent:'#F2B51D',onAccent:'#2B1E00',paper:'#F5F8FC',card:'#FFFFFF',ink:'#14263D',muted:'#4F6178',on:'#FFFFFF',frame:'#D4AF37',title:'#F2B51D'},
 green:{n:'เขียว',primary:'#13704F',dark:'#0B4733',accent:'#F3C33C',onAccent:'#2A2000',paper:'#F3F9F6',card:'#FFFFFF',ink:'#13281F',muted:'#4A665A',on:'#FFFFFF',frame:'#D4AF37',title:'#F3C33C'},
 maroon:{n:'เลือดหมู',primary:'#7D1F2E',dark:'#52121D',accent:'#E9C46A',onAccent:'#3A2400',paper:'#FBF6F3',card:'#FFFFFF',ink:'#2A1418',muted:'#6E5458',on:'#FFFFFF',frame:'#E9C46A',title:'#E9C46A'},
 orange:{n:'ส้ม',primary:'#C8551E',dark:'#8A3611',accent:'#FFD27A',onAccent:'#3A2200',paper:'#FFF7F1',card:'#FFFFFF',ink:'#2E1A10',muted:'#765747',on:'#FFFFFF',frame:'#FFD27A',title:'#FFD27A'},
 teal:{n:'เขียวน้ำทะเล',primary:'#0F6E70',dark:'#094A4C',accent:'#F7B32B',onAccent:'#2E1F00',paper:'#F1F8F8',card:'#FFFFFF',ink:'#102A2B',muted:'#4B6869',on:'#FFFFFF',frame:'#F7B32B',title:'#F7B32B'},
 yellow:{n:'เหลืองราชพิธี',primary:'#F6C619',dark:'#C99700',accent:'#8C1D18',onAccent:'#FFFFFF',paper:'#FFF8DC',card:'#FFFFFF',ink:'#4A2500',muted:'#7A5520',on:'#4A2500',frame:'#9A6B00',title:'#8C1D18'},
 purple:{n:'ม่วง',primary:'#5B2C83',dark:'#3A1A57',accent:'#E6C46B',onAccent:'#2B1A00',paper:'#F8F4FB',card:'#FFFFFF',ink:'#2B1640',muted:'#665577',on:'#FFFFFF',frame:'#E6C46B',title:'#F1D488'},
 sky:{n:'ฟ้า',primary:'#2F6DB5',dark:'#1B4A82',accent:'#E6C46B',onAccent:'#2B1A00',paper:'#F2F7FD',card:'#FFFFFF',ink:'#132B4A',muted:'#55697F',on:'#FFFFFF',frame:'#E6C46B',title:'#F1D488'},
 gold:{n:'ทอง',primary:'#7B5B12',dark:'#4D380A',accent:'#E8C766',onAccent:'#2E2000',paper:'#FFFBF0',card:'#FFFFFF',ink:'#3B2A06',muted:'#76643F',on:'#FFFFFF',frame:'#C9A23A',title:'#F0D27E'},
 saffron:{n:'ส้มพระ',primary:'#C96F0A',dark:'#8C4B04',accent:'#FFF0C2',onAccent:'#3A2200',paper:'#FFF9EE',card:'#FFFFFF',ink:'#3A2205',muted:'#7A5B33',on:'#FFFFFF',frame:'#FFE08A',title:'#FFF0C2'},
 navy:{n:'กรมท่า',primary:'#0B2A5B',dark:'#061A3A',accent:'#E9C46A',onAccent:'#2B1A00',paper:'#F3F6FB',card:'#FFFFFF',ink:'#0F1F3A',muted:'#52617A',on:'#FFFFFF',frame:'#D4AF37',title:'#F1D488'},
 forest:{n:'เขียวป่า',primary:'#1F5130',dark:'#11331D',accent:'#E8C766',onAccent:'#2A2000',paper:'#F3F8F4',card:'#FFFFFF',ink:'#15281B',muted:'#4C6352',on:'#FFFFFF',frame:'#D4AF37',title:'#F0D27E'},
 indigo:{n:'คราม',primary:'#2E2F7A',dark:'#1B1C4F',accent:'#F2C94C',onAccent:'#2B1E00',paper:'#F4F4FB',card:'#FFFFFF',ink:'#1B1C3A',muted:'#5A5B7A',on:'#FFFFFF',frame:'#E2BD55',title:'#F5D77A'},
 crimson:{n:'แดง',primary:'#9E1B2F',dark:'#65101D',accent:'#F5C842',onAccent:'#3A2400',paper:'#FCF5F5',card:'#FFFFFF',ink:'#2B1216',muted:'#6E5256',on:'#FFFFFF',frame:'#E9C46A',title:'#F5D77A'},
 ocean:{n:'น้ำทะเล',primary:'#0D5C8C',dark:'#083B5C',accent:'#F7C948',onAccent:'#2E2000',paper:'#F1F7FB',card:'#FFFFFF',ink:'#0E2A3D',muted:'#4D6577',on:'#FFFFFF',frame:'#E2BD55',title:'#F7D77E'},
 rose:{n:'ชมพู',primary:'#A8355E',dark:'#6E1F3D',accent:'#F6D27A',onAccent:'#3A2400',paper:'#FCF4F7',card:'#FFFFFF',ink:'#2E1420',muted:'#70515E',on:'#FFFFFF',frame:'#EBC777',title:'#F8DC8E'},
 mourn:{n:'ไว้ทุกข์',primary:'#161616',dark:'#050505',accent:'#D9D9D9',onAccent:'#111111',paper:'#F2F2F2',card:'#FFFFFF',ink:'#111111',muted:'#555555',on:'#F4F4F4',frame:'#BDBDBD',title:'#FFFFFF'},
 mournGold:{n:'ดำ-ทอง',primary:'#1C1712',dark:'#0B0806',accent:'#C9A54C',onAccent:'#1C1712',paper:'#F6F1E6',card:'#FFFFFF',ink:'#1C1712',muted:'#6B5E48',on:'#F3EBDD',frame:'#C9A54C',title:'#D9B85E'}
};

const SIGN='ข้าพระพุทธเจ้า ผู้บริหาร ข้าราชการ และบุคลากร\n'+ORG;
const TPL=[
 {id:'n1',g:'จดหมายข่าว (ลวดลาย)',name:'ธงชาติไทย',L:'letter',deco:'flag',style:'classic',th:'ocean',d:{kicker:'ประชาสัมพันธ์',title:`${ORG} จัดกิจกรรมพัฒนาคุณภาพผู้เรียน`,body:`วันที่ ${TODAY} ${FULLNAME} จัดกิจกรรมพัฒนาคุณภาพผู้เรียน เพื่อส่งเสริมการเรียนรู้ตลอดชีวิต โดยมีนักศึกษา ครู และบุคลากรเข้าร่วมกิจกรรมอย่างพร้อมเพรียง`,body2:'กิจกรรมดังกล่าวจัดขึ้นเพื่อพัฒนาทักษะที่จำเป็นของผู้เรียน และเปิดโอกาสให้นักศึกษาได้แลกเปลี่ยนเรียนรู้ร่วมกัน'}},
 {id:'n2',g:'จดหมายข่าว (ลวดลาย)',name:'ดอกไม้ขาว',L:'letter',deco:'flowers',style:'wide',th:'navy',d:{kicker:'ประชาสัมพันธ์',title:`${ORG} จัดกิจกรรมพัฒนาคุณภาพผู้เรียน`,body:`วันที่ ${TODAY} ${FULLNAME} จัดกิจกรรมพัฒนาคุณภาพผู้เรียน เพื่อส่งเสริมการเรียนรู้ตลอดชีวิต โดยมีนักศึกษา ครู และบุคลากรเข้าร่วมกิจกรรมอย่างพร้อมเพรียง`,body2:'กิจกรรมดังกล่าวจัดขึ้นเพื่อพัฒนาทักษะที่จำเป็นของผู้เรียน และเปิดโอกาสให้นักศึกษาได้แลกเปลี่ยนเรียนรู้ร่วมกัน'}},
